# Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Bifrost (OpenAI-compatible gateway)
BIFROST_BASE_URL=https://your-bifrost-host/v1
BIFROST_VIRTUAL_KEY=your_bifrost_virtual_key_here
BIFROST_MODEL=your_model_id_here

# Server
PORT=3001

# Set to true to force mock responses for UI testing
MOCK_MODE=true