{
  "name": "freshcheck-ai",
  "version": "1.0.0",
  "description": "AI-powered stale-answer detection and fact verification using Tavily and Bifrost.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.mjs",
    "test:tavily": "node test-tavily.mjs"
  },
  "keywords": [
    "freshcheck",
    "fact-check",
    "tavily",
    "bifrost"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tavily/core": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}